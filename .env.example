# ==============================================================================
# ForgeHub Configuration Template
# ==============================================================================

# Server Environment
FORGEHUB_ENV=development
FORGEHUB_PORT=8080
FORGEHUB_HOST=0.0.0.0
FORGEHUB_BASE_URL=http://localhost:8080
FORGEHUB_WEB_URL=http://localhost:5173

# Database (PostgreSQL 16+)
# When running standalone in development without PostgreSQL, omit or set to "embedded"
DATABASE_URL=postgres://forgehub:forgehub_secret@localhost:5432/forgehub?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINS=30

# Cache & Queues (Redis 7+)
# When running standalone in development without Redis, omit or set to "embedded"
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Security & Sessions
SESSION_SECRET=dev_session_secret_change_in_production_32bytes_minimum!
SESSION_COOKIE_NAME=forgehub_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=localhost
SESSION_TTL_HOURS=72
CSRF_SECRET=dev_csrf_secret_change_in_production_32bytes_min!

# Git Storage
GIT_ROOT_DIR=./data/git
GIT_DEFAULT_BRANCH=main
GIT_MAX_DIFF_LINES=5000
GIT_MAX_DIFF_BYTES=5242880

# Logging & Observability
LOG_LEVEL=info
LOG_FORMAT=json

# ForgeAI
FORGEAI_ENABLED=false
FORGEAI_PROVIDER=none
FORGEAI_API_KEY=
